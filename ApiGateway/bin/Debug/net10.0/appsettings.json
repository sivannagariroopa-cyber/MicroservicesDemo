{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "MySuperSecretKeyForDevelopmentOnly123456789",
    "Issuer": "MyMicroservices",
    "Audience": "MyMicroservicesUsers"
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },

      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "orders-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "order-service-1": {
            "Address": "https://localhost:7221/"
          },
          "order-service-2": {
            "Address": "https://localhost:7222/"
          }
        }
      },

      "products-cluster": {
        "Destinations": {
          "product1": {
            "Address": "http://localhost:5141/"
          }
        }
      }
    }
  }
}